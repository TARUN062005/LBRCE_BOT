NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lbrce_ai
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
COOKIE_SAMESITE=lax

# Server-side only. Never put this in the React app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional Atlas Vector Search index name. Leave empty to use lexical search
# plus an in-database cosine fallback when embeddings exist.
VECTOR_SEARCH_INDEX=

ADMIN_EMAIL=admin@lbrce.local
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=LBRCE Administrator

CRAWL_MAX_PAGES=40
CRAWL_MAX_DOCUMENTS=20
CRAWL_DELAY_MS=1500
CRAWL_ALLOWED_HOSTS=lbrce.ac.in
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
OCR_ENABLED=false
RUN_WORKER=true
LOG_LEVEL=info
